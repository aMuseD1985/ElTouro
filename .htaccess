# ElTouro App (beta/test/live)
# -MultiViews: old files like seite.php are still on the server (deployments never delete) and would
# otherwise answer /seite/x or /impressum before the rewrite rules get a chance
Options -Indexes -MultiViews
DirectoryIndex index.php

# Libraries, includes and docs are never served directly
<FilesMatch "^(config\.php|config\.example\.php|bootstrap\.php|core\.php|lang\.php|mailer\.php|account_lib\.php|crews_lib\.php|tours_lib\.php|forum_lib\.php|talk_lib\.php|rides_lib\.php|share_lib\.php|tour_name_lib\.php|geocoder_lib\.php|track_lib\.php|poi_lib\.php|live_lib\.php|community_lib\.php|google_lib\.php|rewards_lib\.php|legal_texts\.php|ops_lib\.php|migrations\.php|.*\.md|\.git.*)$">
    Require all denied
</FilesMatch>
# Web app (PWA): manifest type, and the service worker must always be fetched fresh
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>
<FilesMatch "^_">
    Require all denied
</FilesMatch>

RewriteEngine On

# Runtime data, vendored libraries and CI configuration: no access from the browser
RewriteRule ^(data|daten|lib|docs|tools|\.github)(/|$) - [F,L]

# Any .php address requested from outside (old German pages, links in mails sent before the clean
# URLs) goes to legacy.php, which redirects permanently to the clean URL. THE_REQUEST is the original
# request line, so the internal rewrites below never land here.
RewriteCond %{THE_REQUEST} \s/[^\s?]*\.php[\s?]
RewriteRule ^ legacy.php [L]
# Old clean URLs without .php: plain redirects (an internal rewrite to legacy.php did not take effect on the host)
RewriteRule ^impressum/?$ /imprint [R=301,L]
RewriteRule ^datenschutz/?$ /privacy [R=301,L]
RewriteRule ^nutzungsbedingungen/?$ /terms [R=301,L]
RewriteRule ^seite/(impressum|datenschutz|nutzungsbedingungen)/?$ /$1 [R=301,L]
RewriteRule ^seite/([a-z0-9-]+)/?$ /page/$1 [R=301,L]
RewriteRule ^assets/(planer|tourkarte|traenke)\.js$ - [G,L]

# ---- Clean URLs (internal rewrites; query strings are kept) ----
RewriteRule ^access/?$ access.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^register/google/?$ register_google.php [L,QSA]
RewriteRule ^verify/?$ verify.php [L,QSA]
RewriteRule ^password/forgot/?$ password_forgot.php [L,QSA]
RewriteRule ^password/reset/?$ password_reset.php [L,QSA]
RewriteRule ^profile/?$ profile.php [L,QSA]
RewriteRule ^consent/?$ consent.php [L,QSA]
RewriteRule ^account/export/?$ account_export.php [L,QSA]
RewriteRule ^account/delete/?$ account_delete.php [L,QSA]
RewriteRule ^auth/google/?$ auth_google.php [L,QSA]
RewriteRule ^join/([a-z0-9]{10})/?$ join.php?code=$1 [L,QSA]
RewriteRule ^auth/google/callback/?$ auth_google.php?callback=1 [L,QSA]

RewriteRule ^crews/?$ crews.php [L,QSA]
RewriteRule ^crews/new/?$ crew_new.php [L,QSA]
RewriteRule ^crew/([a-z0-9-]+)/?$ crew.php?s=$1 [L,QSA]
RewriteRule ^crew/([a-z0-9-]+)/talk/?$ talk.php?s=$1 [L,QSA]
RewriteRule ^talk/([0-9]+)/?$ talk_topic.php?id=$1 [L,QSA]
RewriteRule ^api/talk/?$ talk_api.php [L,QSA]

RewriteRule ^tours/?$ tours.php [L,QSA]
RewriteRule ^tour/plan/?$ tour_plan.php [L,QSA]
RewriteRule ^tour/([0-9]+)/?$ tour.php?id=$1 [L,QSA]
RewriteRule ^tour/([0-9]+)/edit/?$ tour_plan.php?id=$1 [L,QSA]
RewriteRule ^tour/([0-9]+)/gpx/?$ tour_gpx.php?id=$1 [L,QSA]
RewriteRule ^tour/([0-9]+)/thumb\.png$ tour_thumb.php?id=$1 [L,QSA]
RewriteRule ^tour/([0-9]+)/go/?$ tour_go.php?id=$1 [L,QSA]
RewriteRule ^api/route/?$ route.php [L,QSA]
RewriteRule ^api/tour-name/?$ tour_name.php [L,QSA]
RewriteRule ^api/place-search/?$ place_search.php [L,QSA]
RewriteRule ^api/place-name/?$ place_name.php [L,QSA]
RewriteRule ^api/track/?$ track.php [L,QSA]
RewriteRule ^api/stops/?$ stops.php [L,QSA]
RewriteRule ^api/live/?$ live.php [L,QSA]
RewriteRule ^avatar/([0-9]+)/?$ avatar.php?id=$1 [L,QSA]
RewriteRule ^api/forum/react/?$ forum_react.php [L,QSA]
RewriteRule ^live/?$ live_map.php [L,QSA]
RewriteRule ^s/([A-Za-z0-9_-]{24})/?$ share.php?token=$1 [L,QSA]
RewriteRule ^s/([A-Za-z0-9_-]{24})/image\.png$ share.php?token=$1&image=1 [L,QSA]

RewriteRule ^rides/?$ rides.php [L,QSA]
RewriteRule ^ride/new/?$ ride_edit.php [L,QSA]
RewriteRule ^ride/([0-9]+)/?$ ride.php?id=$1 [L,QSA]
RewriteRule ^ride/([0-9]+)/edit/?$ ride_edit.php?id=$1 [L,QSA]

RewriteRule ^forum/?$ forum.php [L,QSA]
RewriteRule ^forum/topic/([0-9]+)/?$ forum_topic.php?t=$1 [L,QSA]
RewriteRule ^forum/([a-z0-9-]+)/?$ forum_category.php?c=$1 [L,QSA]
RewriteRule ^forum/([a-z0-9-]+)/new/?$ forum_new.php?c=$1 [L,QSA]

RewriteRule ^report/?$ report.php [L,QSA]
RewriteRule ^(imprint|privacy|terms)/?$ page.php?s=$1 [L,QSA]
RewriteRule ^page/([a-z0-9-]+)/?$ page.php?s=$1 [L,QSA]

RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/(pages|settings|users|forum|reports|ops)/?$ admin/$1.php [L,QSA]

RewriteRule ^migrate/?$ migrate.php [L,QSA]
RewriteRule ^check/?$ check.php [L,QSA]

# Enforcing HTTPS: please enable "SSL erzwingen" under SSL-Schutz in the KAS instead of here.
# A rule of our own here can form an endless loop with the KAS setting.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
